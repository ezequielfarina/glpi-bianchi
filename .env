# Valores padrão para desenvolvimento. NÃO coloque segredos reais aqui.
# Sobrescreva em .env.local (não versionado) ou via variáveis de ambiente reais.
#
# Ordem de carga: .env < .env.local < .env.$APP_ENV < .env.$APP_ENV.local

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-in-env-local
###< symfony/framework-bundle ###

###> symfony/routing ###
# URL base usada para gerar links absolutos fora de um request HTTP (CLI, workers).
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://bianchi:bianchi@127.0.0.1:5432/bianchi?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Fila de ingestão do inventário (Valkey/Redis Streams)
MESSENGER_TRANSPORT_DSN=redis://127.0.0.1:6379/inventory
# Fila de mensagens com falha (Doctrine, para inspeção via SQL)
MESSENGER_FAILED_DSN=doctrine://default?queue_name=failed
###< symfony/messenger ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> app/inventory ###
# Frequência (horas) informada ao GLPI Agent no campo "expiration"
INVENTORY_FREQUENCY_HOURS=24
# Código da organização que recebe ativos novos sem regra de atribuição
INVENTORY_DEFAULT_ORGANIZATION=root
# Tamanho máximo do payload descompactado (bytes) — 64 MiB
INVENTORY_MAX_PAYLOAD_BYTES=67108864
###< app/inventory ###

###> app/api ###
# Token estático da API REST (/api). Gere com: openssl rand -hex 32
# Fase 2: substituir por OIDC / LDAP.
API_TOKEN=
###< app/api ###

###> app/storage ###
# Diretório dos anexos (fotos, contratos, notas). Produção: /var/lib/glpi-bianchi/files (install.sh)
ATTACHMENTS_DIR=%kernel.project_dir%/var/files
###< app/storage ###

###> app/crypto ###
# Chave (base64, 32 bytes) que cifra chaves de licença no banco. Gere: openssl rand -base64 32
# GUARDE NO BACKUP: sem ela, as chaves de licença gravadas não podem ser lidas.
DATA_ENCRYPTION_KEY=
###< app/crypto ###
