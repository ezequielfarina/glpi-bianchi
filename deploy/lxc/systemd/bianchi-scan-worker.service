# Worker do scanner de rede (fila "scan") — ADR-0012.
# Instalado em /etc/systemd/system/ pelo install.sh.
#
# Roda como o usuário da aplicação, NÃO como root: recebe só CAP_NET_RAW/CAP_NET_ADMIN
# (sockets raw para SYN scan, detecção de SO e ARP) e CAP_NET_BIND_SERVICE (sondas do -sV
# que exigem porta de origem < 1024, ex.: IKE/VPN usa origem UDP 500 — sem ela o nmap
# loga "Bind to 0.0.0.0:500 failed: Permission denied" e não identifica o gateway VPN)
# via capacidades ambientes, que o nmap herda (`--privileged`). Uma varredura por vez.
#
# Reiniciar este serviço (deploy, rotate-secrets.sh) interrompe a varredura em curso: ela é
# registrada como interrompida e, se for agendada, roda de novo em 5 minutos.
[Unit]
Description=GLPI Bianchi - worker do scanner de rede
After=network-online.target valkey-server.service postgresql.service
Wants=network-online.target valkey-server.service postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
ExecStart=/usr/bin/php@PHP_VER@ bin/console messenger:consume scan --time-limit=14400 --memory-limit=512M --no-interaction
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=@APP_DIR@/var

[Install]
WantedBy=multi-user.target
