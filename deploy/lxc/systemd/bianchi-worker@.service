# Worker do Messenger (processa a fila "inventory").
# Instalado em /etc/systemd/system/ pelo install.sh. Uma instância por número:
#   systemctl enable --now bianchi-worker@1 bianchi-worker@2
#   journalctl -fu 'bianchi-worker@*'

[Unit]
Description=GLPI Bianchi - worker de inventario %i
After=network.target postgresql.service valkey-server.service
Wants=postgresql.service valkey-server.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
# --time-limit / --memory-limit: o processo sai limpo e o systemd o recria,
# evitando leak de memória do EntityManager em execuções longas.
ExecStart=/usr/bin/php@PHP_VER@ bin/console messenger:consume inventory --time-limit=3600 --memory-limit=512M --no-interaction
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=120

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=@APP_DIR@/var

[Install]
WantedBy=multi-user.target
